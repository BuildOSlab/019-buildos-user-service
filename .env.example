SERVICE_NAME=buildos-user-service
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/buildos_user

INTERNAL_API_KEY=replace-with-a-strong-random-secret

JWT_SECRET_KEY=replace-with-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=buildos-user-service
AUTH_JWT_ISSUER=buildos-auth-service
JWT_AUDIENCE=buildos-api

PUBLIC_ID_PREFIX=usr

AUTH_SERVICE_URL=http://localhost:8018
AUTH_SERVICE_API_KEY=
AUTH_SERVICE_TIMEOUT=5.0

AUTH_SERVICE_INTERNAL_URL=http://localhost:8018
AUTH_SERVICE_INTERNAL_API_KEY=replace-with-a-strong-random-secret

EVENT_BROKER_URL=
EVENT_BROKER_ENABLED=false
